{
  "name": "k-srouter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:dashboard\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "dev:dashboard": "vite --config vite.config.ts --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && tsc --noEmit -p tsconfig.frontend.json && vite build --config vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
